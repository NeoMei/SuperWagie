{
  "name": "superwagie-markdown-editor-poc",
  "version": "0.0.0-disposable",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:unit": "node --test tests/markdown-model.test.mjs",
