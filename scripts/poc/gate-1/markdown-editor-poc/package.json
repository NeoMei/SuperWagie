    "@codemirror/view": "6.39.6",
    "dompurify": "3.4.14",
    "electron": "44.1.0",
    "esbuild": "0.25.9",
    "katex": "0.16.22",
    "markdown-it": "14.3.1",
    "markdown-it-footnote": "4.0.0"
  }
}
