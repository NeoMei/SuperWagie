{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superwagie.example/contracts/v1/viewer-review.schema.json",
  "title": "SuperWagie v1 Viewer review contracts",
  "oneOf": [{ "$ref": "#/$defs/ViewerAnnotationAnchor" }, { "$ref": "#/$defs/DiffCapability" }, { "$ref": "#/$defs/ViewerExportCommand" }],
  "$defs": {
    "ViewerAnnotationAnchor": { "type": "object", "additionalProperties": false, "required": ["source_revision_id", "viewer_identity", "location", "created_render_context"], "properties": { "source_revision_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "viewer_identity": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "location": { "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1, "properties": { "page": { "type": "integer", "minimum": 1 }, "slide": { "type": "integer", "minimum": 1 }, "sheet": { "type": "string", "minLength": 1, "maxLength": 128 }, "record": { "type": "integer", "minimum": 0 }, "element_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" } } }, "normalized_region": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 }, "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } }, "selected_text": { "type": "string", "maxLength": 4096 }, "context_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "created_render_context": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "DiffCapability": { "type": "object", "additionalProperties": false, "required": ["format_variant_id", "modes", "comparability_requirements"], "properties": { "format_variant_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "modes": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["text_diff", "structure_diff", "visual_diff", "time_diff", "metadata_only", "none"] } }, "comparability_requirements": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "enum": ["viewer_identity", "parser_identity", "renderer_identity", "font_environment", "render_parameters", "timeline_identity"] } } } },
    "ViewerExportCommand": { "type": "object", "additionalProperties": false, "required": ["request_id", "viewer_session_id", "source_revision_id", "entry_ids", "target_kind", "conflict_policy"], "properties": { "request_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "viewer_session_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "source_revision_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "entry_ids": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" } }, "target_kind": { "enum": ["workspace_directory", "artifact_staging"] }, "target_directory_handle": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json" }, "conflict_policy": { "enum": ["ask", "rename", "skip"] } } }
  }
}
