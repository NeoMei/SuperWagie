{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superwagie.example/contracts/v1/product-ui-workspace.schema.json",
  "title": "SuperWagie v1 internal Project and Markdown UI protocol",
  "oneOf": [
    { "$ref": "#/$defs/RendererIntent" },
    { "$ref": "#/$defs/ShellSelection" },
    { "$ref": "#/$defs/QueryRequest" },
    { "$ref": "#/$defs/DraftStageRequest" }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "Revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "IntentBase": {
      "type": "object",
      "required": [
        "protocol_version", "request_id", "command_type", "resource_refs",
        "requested_permissions", "payload", "issued_at"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/Identifier" },
        "command_type": { "type": "string" },
        "resource_refs": { "type": "array", "maxItems": 128, "items": { "type": "object" } },
        "requested_permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "expected_revision": { "type": "integer", "minimum": 0 },
        "payload": { "type": "object" },
        "issued_at": { "type": "string", "format": "date-time" },
        "deadline_at": { "type": "string", "format": "date-time" }
      }
    },
    "ProjectIntent": {
      "allOf": [
        { "$ref": "#/$defs/IntentBase" },
        {
          "properties": {
            "command_type": { "enum": ["project.activate", "project.revoke"] },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["project_id"],
              "properties": { "project_id": { "$ref": "#/$defs/Identifier" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "DocumentOpenCloseIntent": {
      "allOf": [
        { "$ref": "#/$defs/IntentBase" },
        {
          "properties": {
            "command_type": { "enum": ["document.open", "document.close"] },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_id"],
              "properties": { "document_id": { "$ref": "#/$defs/Identifier" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "DocumentSaveIntent": {
      "allOf": [
        { "$ref": "#/$defs/IntentBase" },
        {
          "properties": {
            "command_type": { "const": "document.save" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_id", "base_revision", "draft_handle_id", "change_generation"],
              "properties": {
                "document_id": { "$ref": "#/$defs/Identifier" },
                "base_revision": { "$ref": "#/$defs/Revision" },
                "draft_handle_id": { "$ref": "#/$defs/Identifier" },
                "change_generation": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "DocumentResolveConflictIntent": {
      "allOf": [
        { "$ref": "#/$defs/IntentBase" },
        {
          "properties": {
            "command_type": { "const": "document.resolve_conflict" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["conflict_id", "latest_revision", "action"],
              "properties": {
                "conflict_id": { "$ref": "#/$defs/Identifier" },
                "latest_revision": { "$ref": "#/$defs/Revision" },
                "action": { "enum": ["merge", "keep_current", "use_disk"] },
                "draft_handle_id": { "$ref": "#/$defs/Identifier" }
              },
              "allOf": [
                {
                  "if": { "properties": { "action": { "enum": ["merge", "keep_current"] } } },
                  "then": { "required": ["draft_handle_id"] }
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RendererIntent": {
      "oneOf": [
        { "$ref": "#/$defs/ProjectIntent" },
        { "$ref": "#/$defs/DocumentOpenCloseIntent" },
        { "$ref": "#/$defs/DocumentSaveIntent" },
        { "$ref": "#/$defs/DocumentResolveConflictIntent" }
      ]
    },
    "ShellSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection_type", "selected_root"],
          "properties": {
            "selection_type": { "const": "selected" },
            "selected_root": { "type": "string", "minLength": 1, "maxLength": 32768 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection_type"],
          "properties": { "selection_type": { "const": "cancelled" } }
        }
      ]
    },
    "QueryRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "message_type", "request_id", "query_id", "params"],
          "properties": {
            "protocol_version": { "const": 1 },
            "message_type": { "const": "query.execute" },
            "request_id": { "$ref": "#/$defs/Identifier" },
            "query_id": { "const": "project.list" },
            "params": { "type": "object", "additionalProperties": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "message_type", "request_id", "query_id", "params"],
          "properties": {
            "protocol_version": { "const": 1 },
            "message_type": { "const": "query.execute" },
            "request_id": { "$ref": "#/$defs/Identifier" },
            "query_id": { "const": "workspace.tree" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["project_id"],
              "properties": { "project_id": { "$ref": "#/$defs/Identifier" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "message_type", "request_id", "query_id", "params"],
          "properties": {
            "protocol_version": { "const": 1 },
            "message_type": { "const": "query.execute" },
            "request_id": { "$ref": "#/$defs/Identifier" },
            "query_id": { "const": "document.snapshot" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_id"],
              "properties": { "document_id": { "$ref": "#/$defs/Identifier" } }
            }
          }
        }
      ]
    },
    "DraftStageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "document_id", "base_revision", "change_generation", "byte_length"],
      "properties": {
        "protocol_version": { "const": 1 },
        "document_id": { "$ref": "#/$defs/Identifier" },
        "base_revision": { "$ref": "#/$defs/Revision" },
        "change_generation": { "type": "integer", "minimum": 0 },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      }
    }
  }
}
