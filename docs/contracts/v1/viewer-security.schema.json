{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superwagie.example/contracts/v1/viewer-security.schema.json",
  "title": "SuperWagie v1 Viewer security contracts",
  "oneOf": [{ "$ref": "#/$defs/ViewerResourceHandle" }, { "$ref": "#/$defs/SecretHandle" }, { "$ref": "#/$defs/FontEnvironment" }, { "$ref": "#/$defs/OfficeFeatureInventory" }],
  "$defs": {
    "ViewerResourceHandle": { "allOf": [{ "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json" }, { "properties": { "resource_type": { "enum": ["viewer_input", "viewer_derived_asset"] }, "allowed_operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["read", "range_read", "inspect"] } }, "audience": { "type": "object", "properties": { "kind": { "enum": ["surface", "worker"] } } } } }] },
    "SecretHandle": { "type": "object", "additionalProperties": false, "required": ["secret_handle_id", "audience", "operation", "issued_at", "expires_at", "one_shot", "auth_tag"], "properties": { "secret_handle_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "audience": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "operation": { "const": "decrypt_current_document" }, "issued_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": "string", "format": "date-time" }, "one_shot": { "const": true }, "auth_tag": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" } } },
    "FontEnvironment": { "type": "object", "additionalProperties": false, "required": ["font_environment_id", "font_hash", "sources", "substitutions"], "properties": { "font_environment_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "font_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "sources": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["family", "source", "identity"], "properties": { "family": { "type": "string", "minLength": 1, "maxLength": 128 }, "source": { "enum": ["embedded", "system", "bundled", "substitution"] }, "identity": { "type": "string", "minLength": 1, "maxLength": 256 } } } }, "substitutions": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["requested", "resolved"], "properties": { "requested": { "type": "string", "minLength": 1, "maxLength": 128 }, "resolved": { "type": "string", "minLength": 1, "maxLength": 128 } } } } } },
    "OfficeFeatureInventory": { "type": "object", "additionalProperties": false, "required": ["source_revision_id", "content_types", "namespaces", "relationships", "drawing_objects", "embedded_objects", "macros", "external_links", "fonts", "themes_masters", "protection", "unknown_features"], "properties": { "source_revision_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "content_types": { "$ref": "#/$defs/StringList" }, "namespaces": { "$ref": "#/$defs/StringList" }, "relationships": { "$ref": "#/$defs/StringList" }, "drawing_objects": { "$ref": "#/$defs/StringList" }, "embedded_objects": { "$ref": "#/$defs/StringList" }, "macros": { "type": "boolean" }, "external_links": { "$ref": "#/$defs/StringList" }, "fonts": { "$ref": "#/$defs/StringList" }, "themes_masters": { "$ref": "#/$defs/StringList" }, "protection": { "$ref": "#/$defs/StringList" }, "unknown_features": { "$ref": "#/$defs/StringList" } } },
    "StringList": { "type": "array", "maxItems": 2048, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
  }
}
