{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superwagie.example/contracts/v1/resource-handle.schema.json",
  "title": "SuperWagie v1 ResourceHandle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handle_id", "resource_type", "resource_id", "resource_revision", "audience",
    "allowed_operations", "project_id", "owner_type", "owner_id", "media_type",
    "size_limit_bytes", "range_limit_bytes", "issued_at", "expires_at", "one_shot",
    "auth_tag"
  ],
  "properties": {
    "handle_id": { "$ref": "#/$defs/Identifier" },
    "resource_type": {
      "enum": [
        "workspace_file", "artifact", "preview_page", "staged_output",
        "media_asset", "diagram_document"
      ]
    },
    "resource_id": { "$ref": "#/$defs/Identifier" },
    "resource_revision": { "$ref": "#/$defs/Identifier" },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["surface", "worker", "capability"] },
        "id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "allowed_operations": {
      "type": "array",
      "items": { "enum": ["read", "range_read", "write_staging", "render"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "project_id": { "$ref": "#/$defs/Identifier" },
    "owner_type": { "enum": ["project", "task_thread", "workflow_run", "delivery_project"] },
    "owner_id": { "$ref": "#/$defs/Identifier" },
    "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
    "size_limit_bytes": { "type": "integer", "minimum": 1 },
    "range_limit_bytes": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "one_shot": { "type": "boolean" },
    "auth_tag": {
      "type": "string",
      "description": "Keyed MAC or digital signature generated by Rust Product Core; a plain content hash is not sufficient.",
      "pattern": "^[A-Za-z0-9_-]{43,128}$"
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    }
  }
}
