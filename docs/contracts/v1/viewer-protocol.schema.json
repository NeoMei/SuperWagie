{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superwagie.example/contracts/v1/viewer-protocol.schema.json",
  "title": "SuperWagie v1 internal Viewer protocol",
  "oneOf": [{ "$ref": "#/$defs/ViewerOpenCommand" }, { "$ref": "#/$defs/ViewerDiagnostic" }, { "$ref": "#/$defs/ViewerStateSnapshot" }],
  "$defs": {
    "ViewerOpenCommand": { "type": "object", "additionalProperties": false, "required": ["protocol_version", "viewer_session_id", "resource_handle", "file_identity", "expected_revision"], "properties": { "protocol_version": { "const": 1 }, "viewer_session_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "resource_handle": { "$ref": "https://superwagie.example/contracts/v1/viewer-security.schema.json#/$defs/ViewerResourceHandle" }, "file_identity": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "expected_revision": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "password_handle": { "$ref": "https://superwagie.example/contracts/v1/viewer-security.schema.json#/$defs/SecretHandle" } } },
    "ViewerDiagnostic": { "type": "object", "additionalProperties": false, "required": ["code", "severity", "forces_partial"], "properties": { "code": { "type": "string", "pattern": "^VIEWER_[A-Z0-9_]{3,64}$" }, "severity": { "enum": ["info", "warning", "error"] }, "forces_partial": { "type": "boolean" }, "message_key": { "type": "string", "minLength": 1, "maxLength": 128 }, "scope": { "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1, "properties": { "page": { "type": "integer", "minimum": 1 }, "slide": { "type": "integer", "minimum": 1 }, "sheet": { "type": "string", "minLength": 1, "maxLength": 128 }, "record": { "type": "integer", "minimum": 0 }, "element_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" } } } } },
    "ViewerStateSnapshot": { "type": "object", "additionalProperties": false, "required": ["viewer_session_id", "revision", "state", "diagnostics", "updated_at"], "properties": { "viewer_session_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "revision": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "state": { "enum": ["detecting", "loading", "password_required", "ready", "partial", "unsupported", "too_large", "corrupt", "failed_recoverable", "failed_terminal", "stale", "cancelled"] }, "diagnostics": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/ViewerDiagnostic" } }, "updated_at": { "type": "string", "format": "date-time" } }, "allOf": [{ "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] }, "then": { "properties": { "diagnostics": { "not": { "contains": { "type": "object", "properties": { "forces_partial": { "const": true } }, "required": ["forces_partial"] } } } } } }] }
  }
}
