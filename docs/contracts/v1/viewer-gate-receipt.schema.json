{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superwagie.example/contracts/v1/viewer-gate-receipt.schema.json",
  "title": "SuperWagie v1 Viewer gate evidence contracts",
  "oneOf": [{ "$ref": "#/$defs/BenchmarkManifest" }, { "$ref": "#/$defs/ViewerGateReceipt" }],
  "$defs": {
    "BenchmarkManifest": { "type": "object", "additionalProperties": false, "required": ["benchmark_id", "machine_id", "cpu", "memory_bytes", "disk", "gpu", "os", "electron_version", "chromium_version", "power_mode", "viewer_identity", "chunk_identity", "font_environment_id", "corpus_sha256", "run_count", "raw_samples_sha256"], "properties": { "benchmark_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "machine_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "cpu": { "type": "string", "minLength": 1, "maxLength": 128 }, "memory_bytes": { "type": "integer", "minimum": 1 }, "disk": { "type": "string", "minLength": 1, "maxLength": 128 }, "gpu": { "type": "string", "minLength": 1, "maxLength": 128 }, "os": { "type": "string", "minLength": 1, "maxLength": 128 }, "electron_version": { "type": "string", "minLength": 1, "maxLength": 64 }, "chromium_version": { "type": "string", "minLength": 1, "maxLength": 64 }, "power_mode": { "type": "string", "minLength": 1, "maxLength": 64 }, "viewer_identity": { "type": "string", "minLength": 1, "maxLength": 256 }, "chunk_identity": { "type": "string", "minLength": 1, "maxLength": 256 }, "font_environment_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "corpus_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "run_count": { "type": "integer", "minimum": 30, "maximum": 10000 }, "raw_samples_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } },
    "ViewerGateReceipt": { "type": "object", "additionalProperties": false, "required": ["receipt_id", "gate_id", "format_variant_id", "viewer_id", "viewer_version", "platform_id", "verdict", "corpus_id", "corpus_sha256", "chunk_manifest_sha256", "evidence_sha256", "issued_at"], "properties": { "receipt_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "gate_id": { "enum": ["GVP-0", "GVP-1", "GVP-2", "GVP-3", "GVP-4", "GVP-5"] }, "format_variant_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "viewer_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "viewer_version": { "type": "string", "minLength": 1, "maxLength": 64 }, "platform_id": { "enum": ["macos-15-arm64", "windows-11-x64"] }, "verdict": { "enum": ["GO", "CONDITIONAL_GO", "NO_GO", "BLOCKED_ENVIRONMENT"] }, "corpus_id": { "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json#/$defs/Identifier" }, "corpus_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "chunk_manifest_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "benchmark_manifest_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "evidence_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "issued_at": { "type": "string", "format": "date-time" } } }
  }
}
