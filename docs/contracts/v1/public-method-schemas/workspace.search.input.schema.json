{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superwagie://schemas/v1/workspace.search.input",
  "title": "workspace.search input schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "scope",
    "limit"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "scope": {
      "$ref": "superwagie://schemas/v1/public-method-common#/$defs/ContentScope"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "cursor": {
      "$ref": "superwagie://schemas/v1/public-method-common#/$defs/Cursor"
    }
  }
}
