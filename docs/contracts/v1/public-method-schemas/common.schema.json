{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superwagie://schemas/v1/public-method-common",
  "title": "SuperWagie public capability shared schema definitions v1",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "Revision": { "type": "integer", "minimum": 0 },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "LogicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*//)(?!.*\\\\)(?!.*%)(?!.*(?:/\\.\\.?)(?:/|$))/(workspace|sources|assets|output|temp)(?:/[^/\\\\\\u0000%]+)*$"
    },
    "PublicHttpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 4096,
      "pattern": "^https://(?![^/?#]*@)(?![a-z0-9.-]*xn--)(?![a-z0-9.-]*0x[0-9a-f]+(?:\\.|:|/|$))(?!(?:[a-z0-9-]+\\.)*(?:localhost|local|localdomain|internal|home|lan)(?::|/|$))(?!(?:[a-z0-9-]+\\.)*(?:nip\\.io|sslip\\.io|localtest\\.me|lvh\\.me|vcap\\.me)(?::|/|$))(?![0-9.]+(?::|/|$))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?::[0-9]{1,5})?(?:[/?#].*)?$"
    },
    "SafeAiText": {
      "type": "string",
      "maxLength": 100000,
      "not": {
        "pattern": "(?:[Pp][Rr][Oo][Vv][Ii][Dd][Ee][Rr]|[Mm][Oo][Dd][Ee][Ll]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ii][Nn][Tt][Ee][Rr][Nn][Aa][Ll][_-]?[Cc][Oo][Ss][Tt]|[Vv][Ee][Nn][Dd][Oo][Rr]|[Ee][Nn][Gg][Ii][Nn][Ee]|[Bb][Aa][Cc][Kk][Ee][Nn][Dd])\\s*[:=]"
      }
    },
    "Cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
    "ArtifactRef": {
      "$ref": "https://superwagie.example/contracts/v1/envelopes.schema.json#/$defs/ArtifactRef"
    },
    "ResourceHandle": {
      "$ref": "https://superwagie.example/contracts/v1/resource-handle.schema.json"
    },
    "ArtifactOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_type", "owner_id"],
      "properties": {
        "owner_type": { "enum": ["project", "task_thread", "workflow_run", "delivery_project"] },
        "owner_id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "ContentScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_paths"],
      "properties": {
        "logical_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/LogicalPath" }
        }
      }
    },
    "WorkingSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_paths"],
      "properties": {
        "logical_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/LogicalPath" }
        }
      }
    },
    "OperationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "status", "recorded_at"],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["completed", "accepted"] },
        "recorded_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "UsageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage_receipt_id", "capability_category", "credits", "status", "recorded_at"],
      "properties": {
        "usage_receipt_id": { "$ref": "#/$defs/Identifier" },
        "capability_category": { "enum": ["chat", "reason", "vision", "ocr", "image", "audio"] },
        "credits": { "type": "number", "minimum": 0 },
        "status": { "enum": ["settlement_pending", "settled"] },
        "recorded_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "TaskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "state", "revision"],
      "properties": {
        "task_id": { "$ref": "#/$defs/Identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "state": { "enum": ["inbox", "planned", "in_progress", "waiting_user", "blocked", "completed", "cancelled", "superseded"] },
        "revision": { "$ref": "#/$defs/Revision" }
      }
    },
    "WpsPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_kind", "operations"],
      "properties": {
        "document_kind": { "enum": ["document", "presentation", "spreadsheet"] },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["create_document", "create_slide", "insert_text", "replace_text", "apply_style", "add_artifact"] },
              "target_ref": { "$ref": "#/$defs/Identifier" },
              "text": { "type": "string", "maxLength": 100000 },
              "artifact": { "$ref": "#/$defs/ArtifactRef" }
            }
          }
        }
      }
    },
    "OutputSchemaRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "root_type"],
      "properties": {
        "schema_id": { "$ref": "#/$defs/Identifier" },
        "root_type": { "enum": ["object", "array", "string"] },
        "required_fields": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "SafeStructuredValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 100000 },
        {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/SafeStructuredValue" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(?!.*(?:[Pp][Rr][Oo][Vv][Ii][Dd][Ee][Rr]|[Mm][Oo][Dd][Ee][Ll]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ii][Nn][Tt][Ee][Rr][Nn][Aa][Ll][_-]?[Cc][Oo][Ss][Tt]|[Vv][Ee][Nn][Dd][Oo][Rr]|[Ee][Nn][Gg][Ii][Nn][Ee]|[Bb][Aa][Cc][Kk][Ee][Nn][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Ss][Ee][Cc][Rr][Ee][Tt])).*$"
          },
          "additionalProperties": { "$ref": "#/$defs/SafeStructuredValue" }
        }
      ]
    }
  }
}
