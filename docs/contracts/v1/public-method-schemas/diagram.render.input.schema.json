{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superwagie://schemas/v1/diagram.render.input",
  "title": "diagram.render input schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "format",
    "width",
    "height"
  ],
  "properties": {
    "source": {
      "$ref": "superwagie://schemas/v1/public-method-common#/$defs/ArtifactRef"
    },
    "format": {
      "enum": [
        "png",
        "svg"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 64,
      "maximum": 8192
    },
    "height": {
      "type": "integer",
      "minimum": 64,
      "maximum": 8192
    }
  }
}
