{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superwagie://schemas/v1/diagram.create.input",
  "title": "diagram.create input schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "semantic_plan",
    "target_logical_path"
  ],
  "properties": {
    "format": {
      "enum": [
        "excalidraw",
        "drawio"
      ]
    },
    "target_logical_path": {
      "$ref": "superwagie://schemas/v1/public-method-common#/$defs/LogicalPath"
    },
    "semantic_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "label"
            ],
            "properties": {
              "node_id": {
                "$ref": "superwagie://schemas/v1/public-method-common#/$defs/Identifier"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "kind": {
                "enum": [
                  "concept",
                  "process",
                  "decision",
                  "actor",
                  "artifact"
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "superwagie://schemas/v1/public-method-common#/$defs/Identifier"
              },
              "to": {
                "$ref": "superwagie://schemas/v1/public-method-common#/$defs/Identifier"
              },
              "label": {
                "type": "string",
                "minLength": 0,
                "maxLength": 500
              }
            }
          },
          "minItems": 0,
          "maxItems": 2000
        }
      }
    }
  }
}
