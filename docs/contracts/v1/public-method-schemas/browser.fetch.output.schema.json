{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superwagie://schemas/v1/browser.fetch.output",
  "title": "browser.fetch output schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_artifact",
    "metadata"
  ],
  "properties": {
    "response_artifact": {
      "$ref": "superwagie://schemas/v1/public-method-common#/$defs/ArtifactRef"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_code",
        "media_type"
      ],
      "properties": {
        "status_code": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "final_url": {
          "$ref": "superwagie://schemas/v1/public-method-common#/$defs/PublicHttpsUrl"
        }
      }
    }
  }
}
