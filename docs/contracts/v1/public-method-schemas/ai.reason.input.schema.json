{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superwagie://schemas/v1/ai.reason.input",
  "title": "ai.reason input schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem",
    "scope_refs",
    "output_schema"
  ],
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "scope_refs": {
      "type": "array",
      "items": {
        "$ref": "superwagie://schemas/v1/public-method-common#/$defs/ArtifactRef"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "output_schema": {
      "$ref": "superwagie://schemas/v1/public-method-common#/$defs/OutputSchemaRequest"
    }
  }
}
