{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "superwagie://schemas/v1/ai.ocr.input",
  "title": "ai.ocr input schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_artifacts",
    "language_hint"
  ],
  "properties": {
    "source_artifacts": {
      "type": "array",
      "items": {
        "$ref": "superwagie://schemas/v1/public-method-common#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "language_hint": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    }
  }
}
