{
  "name": "@openchamber/electron",
  "version": "2.7.17",
  "private": true,
  "description": "Desktop client for SuperWagie",
  "author": "QUUKK",
  "type": "module",
  "main": "./dist-bundle/entry.mjs",
  "opencodeCli": {
    "version": "2.1.3"
  },
  "dependencies": {
    "@openchamber/web": "workspace:*",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.0",
    "node-abi": "^4.33.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "desktopPrerequisites": [
    "Electron runtime dependencies installed via bun install",
    "Bun available for sidecar compilation",
    "macOS: Xcode + build tools for notarized packaging",
    "Windows: NSIS installed for installer creation",
    "Linux: native x64 or arm64 host (no cross-arch packaging); FUSE/libfuse2 to run AppImages, or APPIMAGE_EXTRACT_AND_RUN=1"
  ],
  "scripts": {
    "dev": "bun ../../scripts/build-builtin-extensions.mjs && node ./scripts/electron-dev.mjs",
    "build:web-assets": "node ./scripts/build-web-assets.mjs",
    "build": "bun -e \"process.exit(0)\"",
    "ensure:electron": "node ./scripts/ensure-electron.mjs",
    "prepare:opencode-cli": "node ./scripts/prepare-opencode-cli.mjs",
    "prepare:ripgrep": "node ./scripts/prepare-ripgrep.mjs",
    "prepare:embedded-knowledge": "node ./scripts/prepare-embedded-knowledge.mjs",
    "verify:opencode-cli": "node ./scripts/verify-opencode-cli.mjs --staged",
    "verify:opencode-cli:packaged": "node ./scripts/verify-opencode-cli.mjs --packaged",
    "verify:linux-appimage": "node ./scripts/verify-linux-appimage.mjs",
    "bundle:main": "bun ./scripts/bundle-main.mjs",
    "generate:macos-icon": "node ./scripts/generate-macos-icon-assets.cjs",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "test": "node ../../scripts/run-isolated-tests.mjs .",
    "test:architecture": "node --test ./electron-dev-mode.test.mjs ./startup-url-selection.test.mjs ./menu-locales.test.mjs ./scripts/target-architecture.test.mjs ./scripts/windows-executable.test.mjs ./scripts/verify-linux-appimage.test.mjs ./scripts/verify-update-manifest.test.mjs ./scripts/ensure-electron.test.mjs",
    "test:updater": "node --test ./updater-capability.test.mjs ./updater-channel.test.mjs ./updater-check.test.mjs ./updater-feed.test.mjs ./scripts/finalize-latest-yml.test.mjs ./scripts/updater-e2e-fixture.test.mjs",
    "test:linux-desktop": "node --test ./linux-autostart.test.mjs ./linux-desktop-entry.test.mjs && node ./scripts/smoke-linux-app-discovery.mjs && node ./scripts/smoke-path-open-utils.mjs",
    "updater:e2e:fixture": "node ./scripts/updater-e2e-fixture.mjs",
    "verify:update-manifest": "node ./scripts/verify-update-manifest.mjs",
    "package": "bun run prepare:superweb && bun run build:web-assets && bun run prepare:opencode-cli && bun run prepare:ripgrep && bun run prepare:embedded-knowledge && bun run bundle:main && bun run rebuild:native && node ./scripts/package.mjs",
    "finalize:latest-yml": "node ./scripts/finalize-latest-yml.mjs",
    "type-check": "node --check ./entry.mjs && node --check ./early-startup.mjs && node --check ./main.mjs && node --check ./preload.mjs && node --check ./browser-panel-preload.cjs",
    "lint": "node -e \"process.exit(0)\"",
    "prepare:superweb": "node ./scripts/prepare-superweb-resource.mjs"
  },
  "build": {
    "appId": "com.quukk.superwagie",
    "productName": "犇马",
    "asarUnpack": [
      "node_modules/@openchamber/web/server/generated/model-resolver.mjs",
      "node_modules/@openchamber/web/server/built-in-extensions/**/*",
      "node_modules/@openchamber/web/server/lib/git/credential-helper.js",
      "node_modules/@openchamber/web/server/lib/git/ssh-wrapper.js",
      "node_modules/@openchamber/web/server/lib/git/repository-credential-helper.js"
    ],
    "files": [
      "dist-bundle/entry.mjs",
      "dist-bundle/main.mjs",
      "dist-bundle/early-startup.mjs",
      "preload.mjs",
      "browser-panel-preload.cjs",
      "!**/node_modules/**/*.{ts,mts,cts,tsx,map}",
      "!**/node_modules/**/!(LICENSE*|LICENCE*|license*|licence*|License*).md",
      "!**/node_modules/bun-pty{,/**}",
      "!**/node_modules/luxon/{src,build/amd,build/global,build/cjs-browser}{,/**}",
      "!node_modules/@openchamber/web/{dist,src,public,scripts,test}{,/**}",
      "!node_modules/@openchamber/web/*.{html,tgz}",
      "!node_modules/@openchamber/web/{tsconfig.json,tsconfig.tsbuildinfo}",
      "!node_modules/@openchamber/web/server/**/*.test.js",
      "!node_modules/node-pty/prebuilds/!(${platform}-${arch}){,/**}",
      "!**/node_modules/@vscode/ripgrep-*{,/**}",
      {
        "from": "../web/server/builtin-skills",
        "to": "node_modules/@openchamber/web/server/builtin-skills",
        "filter": [
          "**/*.md",
          "!**/node_modules/**"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources/web-dist",
        "to": "web-dist"
      },
      {
        "from": "resources/icons/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "resources/icons/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": "resources/icons/tray",
        "to": "icons/tray"
      },
      {
        "from": "resources/opencode-cli",
        "to": "opencode-cli"
      },
      {
        "from": "resources/ripgrep",
        "to": "ripgrep"
      },
      {
        "from": "resources/embedded-knowledge",
        "to": "embedded-knowledge"
      },
      {
        "from": "resources/superweb",
        "to": "superweb",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "buildResources": "resources/icons",
      "output": "dist"
    },
    "artifactName": "SuperWagie-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/icon.icns",
      "artifactName": "SuperWagie-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "SuperWagie needs access to devices and services on your local network.",
        "CFBundleDisplayName": "SuperWagie"
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "artifactName": "SuperWagie-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "OpenChamber <security@openchamber.dev>",
      "vendor": "OpenChamber",
      "synopsis": "Desktop runtime for OpenChamber",
      "icon": "resources/icons/app-icon.png",
      "executableName": "openchamber",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "OpenChamber",
          "Comment": "Desktop runtime for OpenChamber",
          "Icon": "openchamber",
          "StartupWMClass": "openchamber"
        }
      }
    },
    "deb": {
      "afterInstall": "resources/linux/after-install.tpl",
      "afterRemove": "resources/linux/after-remove.tpl"
    },
    "rpm": {
      "afterInstall": "resources/linux/after-install.tpl",
      "afterRemove": "resources/linux/after-remove.tpl"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "resources/installer.nsh",
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico"
    },
    "dmg": {
      "sign": true,
      "title": "${productName} ${version}",
      "backgroundColor": "#FFFCF0",
      "iconSize": 100,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 340
      },
      "contents": [
        {
          "x": 180,
          "y": 140,
          "type": "file"
        },
        {
          "x": 360,
          "y": 140,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
