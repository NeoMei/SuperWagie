{
  "schemaVersion": 1,
  "openmontage": {
    "source": "https://github.com/calesthio/OpenMontage.git",
    "commit": "08e2151fa02de28a5d6a312b3d575692bf147ad7",
    "licenseFile": "LICENSE",
    "checkout": "bundled-subset-default",
    "license": "GNU AGPLv3",
    "bundledRoot": "vendor/openmontage",
    "provenance": "vendor/openmontage/provenance.json"
  },
  "capabilities": [
    "python",
    "ffmpeg",
    "ffprobe",
    "openmontage",
    "python-modules",
    "playwright-browser",
    "playwright-recording",
    "font-readable",
    "tts-bailian",
    "markitdown",
    "python-ooxml",
    "office-browser-renderer"
  ],
  "distribution": {
    "kind": "supervideo-lite-source-engine",
    "install": "npm ci --ignore-scripts",
    "doctor": "node --input-type=module -e \"import { doctor } from './src/providers/doctor.mjs'; import { loadRuntimeConfig } from './src/export.mjs'; console.log(JSON.stringify(await doctor(await loadRuntimeConfig(process.argv[1])), null, 2));\" \"/absolute/runtime.json\"",
    "external": [
      "Node >=20",
      "Python with lxml (fallback semantic extractor)",
      "MarkItDown (optional host semantic extractor)",
      "FFmpeg/ffprobe",
      "Chrome"
    ],
    "excluded": [
      "node_modules",
      "browser binaries",
      "machine runtime config",
      "credentials/login state",
      "system fonts",
      "research probes"
    ],
    "notices": "THIRD_PARTY_NOTICES.md",
    "entrypoint": "node src/runtime-cli.mjs --help"
  },
  "remotion": {
    "version": "4.0.522",
    "renderer": "@remotion/renderer",
    "compiler": "esbuild",
    "browserEntry": "vendor/remotion/render-entry.mjs",
    "excluded": [
      "@remotion/studio",
      "@remotion/bundler",
      "webpack",
      "@rspack/core"
    ]
  }
}
