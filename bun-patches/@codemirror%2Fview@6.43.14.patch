@@ -7150,6 +7150,7 @@
         // Set when a selection change is detected, cleared on flush
         this.selectionChanged = false;
         this.delayedFlush = -1;
+        this.iosParagraphPending = false;
         this.resizeTimeout = -1;
         this.queue = [];
         this.delayedAndroidKey = null;
@@ -7181,6 +7182,17 @@
                 mutations.some(m => m.type == "childList" && m.removedNodes.length ||
                     m.type == "characterData" && m.oldValue.length > m.target.nodeValue.length))
                 this.flushSoon();
+            // OpenChamber patch (temporary, drop once @codemirror/view fixes
+            // it upstream): an iOS keyboard that inserts a paragraph can keep
+            // writing into the DIV it just created. Reading the change now
+            // replaces that DIV with a line tile, and the keyboard's later
+            // text lands in the detached node and is lost. Read the paragraph
+            // with the rest of its batch on the next frame instead.
+            else if (browser.ios && !view.composing && mutations.some(m => m.type == "childList" && m.target == this.dom &&
+                Array.prototype.some.call(m.addedNodes, n => n.nodeName == "DIV"))) {
+                this.iosParagraphPending = true;
+                this.flushSoon();
+            }
             else
                 this.flush();
         });
